{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editon",
  "version": "0.2.3",
  "identifier": "com.aldimenur.editon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Editon",
        "width": 800,
        "height": 600,
        "decorations": false,
        "minWidth": 200,
        "minHeight": 200
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com;",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/1024x1024.png", "icons/1024x1024.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBODI0MjM0QkEwOUMyOUMKUldTY3dnbTZORUtDdXVHdk05MTBISm9TWkFjM25zMGVlRDJnNlQ2aGlVaU1WZzJ6RHNCampjTEMK",
      "endpoints": [
        "https://raw.githubusercontent.com/aldimenur/editon/refs/heads/main/update.json"
      ]
    }
  }
}
